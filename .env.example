# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Authentication (REQUIRED) ─────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Admin login credentials for the web app
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=your-password

# ── SMTP Email Sending (REQUIRED) ─────────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@outlook.com
SMTP_PASS=your-app-password
MAIL_FROM="SmartMail <your-email@outlook.com>"

# ── Campaign Limits ───────────────────────────────────────────────────────────
MAX_RECIPIENTS_PER_CAMPAIGN=2500

# ── Microsoft OAuth (Optional — only if using Outlook OAuth login) ────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Set this to your Render URL: https://your-app.onrender.com/auth/microsoft/callback
MICROSOFT_REDIRECT_URI=https://your-app.onrender.com/auth/microsoft/callback
